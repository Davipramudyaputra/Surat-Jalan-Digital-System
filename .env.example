# Local development only. Replace the password before using this configuration.
POSTGRES_DB=surat_jalan
POSTGRES_USER=surat_jalan
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://surat_jalan:change_this_password@localhost:5432/surat_jalan?schema=public

# Phase 6 — PDF Export
# Secret untuk menandatangani render token PDF (wajib acak di production).
PDF_RENDER_SECRET=change_this_pdf_render_secret
# Origin publik aplikasi (dipakai untuk membentuk URL render internal).
APP_ORIGIN=http://localhost:3000
# Path executable Chrome/Chromium (opsional; fallback path umum dipakai).
# CHROME_PATH=/usr/bin/google-chrome
