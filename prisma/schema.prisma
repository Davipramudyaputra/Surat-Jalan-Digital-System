generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ImportStatus {
  PROCESSING
  IMPORTED
  DUPLICATE
  FAILED
}

enum PrintStatus {
  NOT_PRINTED
  PRINTED
}

model Upload {
  id                  String       @id @default(cuid())
  originalFileName    String
  fileHash            String
  fileSize            Int
  mimeType            String?
  importStatus        ImportStatus @default(PROCESSING)
  detectedSheetName   String?
  detectedHeaderRow   Int?
  detectionConfidence Int?
  purchaseOrderCount  Int          @default(0)
  deliveryNoteCount   Int          @default(0)
  itemCount           Int          @default(0)
  warnings            Json?
  errors              Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  sourcedPurchaseOrders PurchaseOrder[] @relation("LastSourceUpload")

  @@index([fileHash])
  @@index([importStatus])
}

model PurchaseOrder {
  id                 String   @id @default(cuid())
  companyCode        String
  companyName        String
  poNumber           String
  normalizedPoNumber String
  period             String?
  lastSourceUploadId String?
  deletedAt          DateTime?
  deletedById        String?
  deletionReason     String?
  trashBatchId       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lastSourceUpload Upload?        @relation("LastSourceUpload", fields: [lastSourceUploadId], references: [id], onDelete: SetNull)
  deletedBy        User?          @relation("PODeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deliveryNotes    DeliveryNote[]

  @@index([companyCode])
  @@index([normalizedPoNumber])
  @@index([lastSourceUploadId])
  @@index([deletedAt])
  @@index([trashBatchId])
}

model DeliveryNote {
  id                   String      @id @default(cuid())
  purchaseOrderId      String
  uniqueCode           String
  documentNumber       String?
  documentDate         DateTime?
  recipientCompanyName String
  originalBranchName   String
  branchName           String
  normalizedBranchName String
  vehicleName          String?
  vehicleNumber        String?
  additionalPoNumber   String?
  recipientName        String?
  printStatus          PrintStatus @default(NOT_PRINTED)
  firstPrintedAt       DateTime?
  lastPrintedAt        DateTime?
  printCount           Int         @default(0)
  deletedAt            DateTime?
  deletedById          String?
  deletionReason       String?
  trashBatchId         String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  deletedBy     User?              @relation("DNDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  items         DeliveryNoteItem[]

  @@index([normalizedBranchName])
  @@index([printStatus])
  @@index([deletedAt])
  @@index([trashBatchId])
}

model DeliveryNoteItem {
  id                    String   @id @default(cuid())
  deliveryNoteId        String
  originalProductName   String
  displayProductName    String
  normalizedProductName String
  sourceQuantity        Decimal  @db.Decimal(20, 3)
  quantity              Decimal  @db.Decimal(20, 3)
  unit                  String?
  description           String?
  sortOrder             Int
  isManuallyEdited      Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@unique([deliveryNoteId, normalizedProductName])
  @@index([deliveryNoteId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id                    String   @id @default(cuid())
  entityType            String
  entityId              String
  entityLabelSnapshot   String?
  action                String
  actorId               String?
  actorNameSnapshot     String?
  actorIdentifierSnapshot String?
  actorRoleSnapshot     String?
  occurredAt            DateTime @default(now())
  source                String
  requestId             String?
  batchId               String?
  changedFields         Json?
  beforeData            Json?
  afterData             Json?
  metadata              Json?
  createdAt             DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([actorId])
  @@index([source])
  @@index([requestId])
  @@index([batchId])
}

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  passwordHash          String
  role                  String    @default("ADMIN")
  isActive              Boolean   @default(true)
  sessions              Session[]
  auditEvents           AuditEvent[] @relation("AuditActor")
  deletedPurchaseOrders PurchaseOrder[] @relation("PODeletedBy")
  deletedDeliveryNotes  DeliveryNote[] @relation("DNDeletedBy")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
